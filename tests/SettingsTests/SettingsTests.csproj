<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-free checks of the mirror name tokens. dotnet run -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- MirrorSettings is plain C#: compile just that file, so no game DLLs are needed at run time -->
    <Compile Include="..\..\src\NOMirrors\MirrorSettings.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
